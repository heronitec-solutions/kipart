(footprint "TEST_TWO_MODELS"
  (version 20241229)
  (generator "pcbnew")
  (layer "F.Cu")
  (descr "Two 3D models")
  (tags "test")
  (attr smd)
  (pad "1" smd rect
    (at -1 0)
    (size 0.5 0.5)
    (layers "F.Cu" "F.Paste" "F.Mask")
  )
  (model "${KIPART_3DMODEL_DIR}\\Capacitors\\C_0402_1005Metric.step"
    (offset
      (xyz 0 0 0.1)
    )
    (scale
      (xyz 1 1 1)
    )
    (rotate
      (xyz 0 0 90)
    )
  )
  (model "${KICAD9_3DMODEL_DIR}/Other/Alt.wrl"
    (offset
      (xyz 0 0 1.2)
    )
    (scale
      (xyz 1 1 1)
    )
    (rotate
      (xyz 0 0 0)
    )
    (opacity 0.5)
    hide
  )
)
